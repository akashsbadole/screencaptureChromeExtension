{
  "name": "chromeRecording",
  "displayName": "Chrome recording",
  "version": "0.0.1",
  "description": "capture image, screen recording",
  "author": "akash badole",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "jspdf": "^2.5.1",
    "html2canvas": "^1.4.1",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "name": "Multi-Tool Pro Extension",
    "description": "Professional web development toolkit with advanced screenshot, recording, and design tools",
    "version": "2.0.0",
    "permissions": [
      "activeTab",
      "tabs",
      "scripting",
      "storage",
      "desktopCapture"
    ],
    "host_permissions": [
      "https://*/*",
      "http://*/*"
    ],
    "options_page": "options.html",
    "action": {
      "default_title": "Multi-Tool Pro - Web Development Toolkit",
      "default_popup": "popup.html"
    }
  }
}
